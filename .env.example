# ---------------------------------------------------------------------------
# PhishGuard — Ortam Değişkenleri
# Bu dosyayı ".env.local" olarak kopyalayın ve değerleri kendi Firebase
# projenizden doldurun. Bu değişkenler TANIMLI DEĞİLSE uygulama otomatik
# olarak "yerel mod"da (localStorage) çalışır; Firebase gerekmez.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Firebase Web App yapılandırması
# (Firebase Console > Proje Ayarları > Genel > "Web uygulaması" bölümünden alın)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sitenin canlı adresi (OG görselinin mutlak URL'e çözülmesi için).
# Örn: NEXT_PUBLIC_SITE_URL=https://phishguard.vercel.app
NEXT_PUBLIC_SITE_URL=

# Eğitmen (yönetici) e-postaları — virgülle ayırın.
# Bu listedeki e-postayla giriş yapan kullanıcı "Yönetici Paneli"ne erişir.
# NOT: Demo eğitmen hesabının e-postasını da bu listeye ekleyin.
# Örn: NEXT_PUBLIC_ADMIN_EMAILS=demo-egitmen@phishguard.app,egitmen@okul.edu.tr
NEXT_PUBLIC_ADMIN_EMAILS=

# Tek tıkla "Demo eğitmen girişi" için hazır hesap (incelemeci/hoca hiçbir şey
# yazmadan giriş yapar). Firebase Authentication'da bu e-posta/parola ile bir
# hesap oluşturun ve e-postasını yukarıdaki NEXT_PUBLIC_ADMIN_EMAILS'e ekleyin.
# Bu yalnızca demo verisi gören, düşük yetkili bir hesaptır.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
