rules_version = '2';

// ---------------------------------------------------------------------------
// PhishGuard — Firestore Güvenlik Kuralları
//
// Kurulum: Firebase Console > Firestore Database > Kurallar sekmesine yapıştırın
// veya `firebase deploy --only firestore:rules` ile dağıtın.
//
// Model:
//   users/{uid}         -> kullanıcının kendi profil özeti
//   sessions/{id}       -> tamamlanmış oturumlar (uid alanı taşır)
//   aggregates/global   -> sınıf geneli sayaçlar (PII içermez)
//
// Yönetici (eğitmen) tespiti: giriş yapan kullanıcının e-postası, uygulamadaki
// NEXT_PUBLIC_ADMIN_EMAILS listesinde ise admindir. Kurallar ortam değişkenini
// okuyamadığından, admin e-postalarını AŞAĞIDAKİ listeye de ekleyin.
// ---------------------------------------------------------------------------

function isAdmin() {
  return request.auth != null
    && request.auth.token.email != null
    && request.auth.token.email.lower() in [
        // >>> Eğitmen e-postalarını buraya ekleyin (küçük harf):
        'egitmen@ornek.com'
      ];
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profili: yalnızca sahibi okuyup yazabilir; admin okuyabilir.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Oturumlar: kullanıcı yalnızca KENDİ uid'siyle oturum oluşturabilir.
    // Okuma yalnızca sahibi veya admin.
    match /sessions/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if false; // oturumlar değiştirilemez (denetim izi)
    }

    // Sınıf geneli sayaçlar: giriş yapan herkes kendi sonucunu ekleyebilir
    // (artışlarla), okuma yalnızca admin. PII içermez.
    match /aggregates/{doc} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }
  }
}
